{
  "version": 1,
  "defaultMode": "PAGE_AUTHORING",
  "baselinePaths": [
    "plugin/baselines/design.json",
    "plugin/baselines/components.json"
  ],
  "ignoredPaths": [
    "renders/**"
  ],
  "modes": {
    "PAGE_AUTHORING": {
      "allowed": [
        "apps/*/docs/briefs/**",
        "apps/*/src/app.ts",
        "apps/*/src/fixtures/**",
        "apps/*/src/flows/**",
        "apps/*/src/pages/**",
        "apps/*/src/screens.ts",
        "apps/*/src/stress-cases.ts",
        "apps/*/tests/**",
        "plugin/code.js"
      ]
    },
    "DESIGN_SYSTEM_CHANGE": {
      "allowed": [
        "apps/*/docs/briefs/**",
        "apps/*/src/fixtures/**",
        "apps/*/tests/**",
        "design-systems/**",
        "docs/design-systems.md",
        "plugin/code.js",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "DESIGN_EXPLORATION": {
      "allowed": [
        "apps/*/docs/briefs/**",
        "apps/*/src/fixtures/**",
        "apps/*/src/lab/**",
        "apps/*/tests/**",
        "plugin/code.js"
      ]
    },
    "STRUCTURAL_MAINTENANCE": {
      "allowed": [
        ".github/**",
        ".gitattributes",
        ".gitignore",
        ".oxlintrc.json",
        "AGENTS.md",
        "CLAUDE.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "apps/**",
        "design-systems/**",
        "docs/**",
        "figma-harness.config.json",
        "package.json",
        "packages/**",
        "plugin/**",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json"
      ]
    },
    "BASELINE_ACCEPTANCE": {
      "allowed": [
        "plugin/baselines/design.json",
        "plugin/baselines/components.json"
      ],
      "requiresExplicitHumanApproval": true
    }
  }
}
