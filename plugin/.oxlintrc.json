{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["typescript", "import", "oxc"],
  "ignorePatterns": [
    "code.js",
    "node_modules/**",
    "renders/**",
    "src/kit/foundations/cvd.generated.ts",
    "src/kit/primitives/icons.generated.ts"
  ],
  "rules": {
    "eslint/no-duplicate-imports": "error",
    "eslint/no-unused-vars": "off",
    "typescript/no-explicit-any": "off",
    "typescript/no-unused-vars": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "env": { "browser": true },
      "globals": {
        "__html__": "readonly",
        "figma": "readonly"
      }
    },
    {
      "files": ["tools/**/*.ts"],
      "env": { "node": true }
    },
    {
      "files": ["src/plugin/entry.ts"],
      "rules": { "import/no-unassigned-import": "off" }
    },
    {
      "files": ["tools/runtime/**/*.ts", "tools/rendering/**/*.ts"],
      "rules": {
        "eslint/no-new": "off",
        "eslint/no-underscore-dangle": "off",
        "typescript/no-this-alias": "off"
      }
    },
    {
      "files": ["tools/accessibility/apca.ts"],
      "rules": { "oxc/approx-constant": "off" }
    }
  ]
}
